{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "_comment": "⚠️ Update ALLOWED_ORIGINS to match YOUR GitHub Pages URL",
    "ALLOWED_ORIGINS": "https://aransyah28.github.io"
  }
}
